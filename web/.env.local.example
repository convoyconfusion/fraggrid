# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Safe to expose to the browser (public dataset read):
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only secrets — create in Sanity Settings -> API -> Tokens (Editor permission):
SANITY_API_TOKEN=

# Server-only secret — from your PandaScore dashboard:
PANDASCORE_TOKEN=

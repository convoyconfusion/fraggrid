{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fraggrid-main",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "-l", "3000"],
      "cwd": "${workspaceFolder}",
      "port": 3000
    },
    {
      "name": "react-nav",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/react-nav",
      "port": 5173
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3001"],
      "cwd": "${workspaceFolder}/web",
      "port": 3001
    }
  ]
}
